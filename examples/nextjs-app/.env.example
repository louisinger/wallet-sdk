# Wallet Configuration
# Private key in hex format (64 characters)
# WARNING: Never commit real private keys!
WALLET_PRIVATE_KEY=

# Network: bitcoin, testnet, signet, mutinynet, or regtest
WALLET_NETWORK=testnet

# Esplora API URL (optional, defaults to mempool.space)
ESPLORA_URL=

# Ark Server Configuration (optional, for off-chain support)
ARK_SERVER_URL=
ARK_SERVER_PUBLIC_KEY=
